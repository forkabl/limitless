assert(is_mac && current_cpu == "arm64",
       "The Phase 1 Limitless foundation currently supports macOS arm64 only.")

# Chromium depends on this stable label. The WebUI resource implementation
# stays beside its source files so build_webui can preserve clean resource
# paths without staging or copying product sources into chromium/src.
group("resources") {
  public_deps = [ "../../shell/resources" ]
}

# Chromium's profile registry reaches the product-owned preference definitions
# through one optional dependency edge.
group("profile_prefs") {
  public_deps = [ "../../shell/control_plane:profile_prefs" ]
}

# Gate 2B compiles the product-owned SwiftUI boundary probe through Chromium's
# normal Apple build graph.
group("swiftui_rail") {
  public_deps = [ "../../shell/native/swiftui_rail:rail" ]
}

# This source set is folded into Chromium's existing WebUI Browser browser-test
# target by the validation patch. The tests remain owned by limitless/tests.
source_set("webui_browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [ "../../tests/browser/limitless_webui_browser_browsertest.cc" ]

  deps = [
    "//base/test:test_support",
    "//chrome/browser/profiles",
    "//chrome/browser/ui",
    "//chrome/browser/ui/webui_browser",
    "//chrome/browser/ui/webui_browser:impl",
    "//chrome/common:chrome_features",
    "//chrome/test:test_support",
    "//components/guest_contents/browser",
