+#if BUILDFLAG(IS_MAC) && defined(ARCH_CPU_ARM64)
+#define MAYBE_EditabilityNotifiesBothWindowsAfterRealDropCompletes \
+  DISABLED_EditabilityNotifiesBothWindowsAfterRealDropCompletes
+#else
+#define MAYBE_EditabilityNotifiesBothWindowsAfterRealDropCompletes \
+  EditabilityNotifiesBothWindowsAfterRealDropCompletes
+#endif
+IN_PROC_BROWSER_TEST_P(DetachToBrowserTabDragControllerTest,
+                       MAYBE_EditabilityNotifiesBothWindowsAfterRealDropCompletes) {
+  AddTabsAndResetBrowser(browser(), 1);
+  ui_test_utils::WaitForBrowserSetLastActive(browser());
+  TabStrip* source_tab_strip = GetTabStripForBrowser(browser());
+  BrowserWindowInterface* destination = CreateAnotherBrowserAndResize();
+  ui_test_utils::WaitForBrowserSetLastActive(destination);
+  TabStrip* destination_tab_strip = GetTabStripForBrowser(destination);
+  TabStripEditabilityObserver source_observer;
+  TabStripEditabilityObserver destination_observer;
+  base::ScopedObservation<TabStripModel, TabStripEditabilityObserver>
+      source_observation(&source_observer);
+  base::ScopedObservation<TabStripModel, TabStripEditabilityObserver>
+      destination_observation(&destination_observer);
+  source_observation.Observe(browser()->GetTabStripModel());
+  destination_observation.Observe(destination->GetTabStripModel());
+
+  Tab* dragged_tab = source_tab_strip->tab_at(0);
+  ASSERT_TRUE(PressInputAtCenter(dragged_tab));
+  ASSERT_TRUE(DragInputToCenterNotifyWhenDone(
+      dragged_tab,
+      base::BindOnce(&DragToSeparateWindowStep2, this, browser(), destination),
+      gfx::Vector2d(0, GetDetachY(source_tab_strip))));
+
+  test::BrowserChangeWaiter(test::BrowserChangeWaiter::ChangeType::kRemoved)
+      .Wait(base::BindLambdaForTesting([&]() {
+        ASSERT_TRUE(IsDragSessionActive(destination_tab_strip));
+        ASSERT_FALSE(IsDragSessionActive(source_tab_strip));
+        ASSERT_TRUE(TabDragController::IsActive());
+        ASSERT_EQ(2, destination->GetTabStripModel()->count());
+        StopAnimating(destination_tab_strip);
+        ASSERT_TRUE(DragInputToCenter(destination_tab_strip->tab_at(1)));
+        ASSERT_TRUE(ReleaseInput());
+      }));
+
+  ASSERT_TRUE(base::test::RunUntil([&]() {
+    return !TabDragController::IsActive() &&
+           TabListInterface::CanEditTabList(*browser()->GetProfile()) &&
+           !source_observer.notifications().empty() &&
+           source_observer.notifications().back() &&
+           !destination_observer.notifications().empty() &&
+           destination_observer.notifications().back();
+  }));
+
+  for (const TabStripEditabilityObserver* observer :
+       {&source_observer, &destination_observer}) {
+    ASSERT_FALSE(observer->notifications().empty());
+    EXPECT_FALSE(observer->notifications().front());
+    EXPECT_TRUE(observer->drag_active().front());
+    EXPECT_TRUE(observer->notifications().back());
+    EXPECT_EQ(observer->notifications(), observer->actual_editability());
+    EXPECT_EQ(1, std::ranges::count(observer->notifications(), true));
+    const auto true_notification =
+        std::ranges::find(observer->notifications(), true);
+    ASSERT_NE(true_notification, observer->notifications().end());
+    const size_t true_index =
+        std::distance(observer->notifications().begin(), true_notification);
+    EXPECT_FALSE(observer->drag_active()[true_index]);
+  }
+  EXPECT_TRUE(TabListInterface::CanEditTabList(*browser()->GetProfile()));
+}
