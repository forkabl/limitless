+void RecomputeProfileTabStripEditability(base::WeakPtr<Profile> profile) {
+  if (!profile) {
+    return;
+  }
+  const bool is_editable = TabListInterface::CanEditTabList(*profile);
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&](BrowserWindowInterface* browser) {
+        if (browser->GetProfile() == profile.get()) {
+          if (TabStripModel* model = browser->GetTabStripModel()) {
+            model->NotifyTabStripEditabilityChanged(is_editable);
+          }
+        }
+        return true;
+      });
+}
+
+void ScheduleProfileTabStripEditabilityRecompute(
+    base::WeakPtr<Profile> profile) {
+  if (!profile || !base::SequencedTaskRunner::HasCurrentDefault()) {
+    return;
+  }
+  base::SequencedTaskRunner::GetCurrentDefault()->PostNonNestableTask(
+      FROM_HERE,
+      base::BindOnce(&RecomputeProfileTabStripEditability, std::move(profile)));
+}
