+class TabStripEditabilityObserver final : public TabStripModelObserver {
+ public:
+  void OnTabStripEditabilityChanged(TabStripModel* tab_strip_model,
+                                    bool is_editable) override {
+    notifications_.push_back(is_editable);
+    actual_editability_.push_back(
+        TabListInterface::CanEditTabList(*tab_strip_model->profile()));
+    drag_active_.push_back(TabDragController::IsActive());
+  }
+
+  const std::vector<bool>& notifications() const { return notifications_; }
+  const std::vector<bool>& actual_editability() const {
+    return actual_editability_;
+  }
+  const std::vector<bool>& drag_active() const { return drag_active_; }
+
+ private:
+  std::vector<bool> notifications_;
+  std::vector<bool> actual_editability_;
+  std::vector<bool> drag_active_;
+};
