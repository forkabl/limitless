+
+bool RenderWidgetHostViewMac::ObserveViewportResize(
+    const gfx::Size& expected_size_in_dip,
+    ViewportResizeCallback commit_callback,
+    ViewportResizeCallback presentation_callback) {
+  CancelViewportResizeObservation();
+  if (expected_size_in_dip.IsEmpty()) {
+    return false;
+  }
+
+  viewport_resize_observation_.emplace(
+      expected_size_in_dip, ViewportSizeInPixels(expected_size_in_dip),
+      std::move(commit_callback), std::move(presentation_callback),
+      std::nullopt, false);
+
+  const cc::RenderFrameMetadata& metadata =
+      host()->render_frame_metadata_provider()->LastRenderFrameMetadata();
+  MaybeAcknowledgeViewportResizeCommit(metadata);
+  MaybeRequestViewportPresentation(metadata);
+  return true;
+}
+
+bool RenderWidgetHostViewMac::RequestSuccessfulPresentationForViewport(
+    const gfx::Size& expected_size_in_dip,
+    ViewportResizeCallback presentation_callback) {
+  if (expected_size_in_dip.IsEmpty() || !presentation_callback) {
+    return false;
+  }
+
+  if (!viewport_resize_observation_ ||
+      viewport_resize_observation_->expected_size_in_dip !=
+          expected_size_in_dip) {
+    CancelViewportResizeObservation();
+    viewport_resize_observation_.emplace(
+        expected_size_in_dip, ViewportSizeInPixels(expected_size_in_dip),
+        ViewportResizeCallback(), std::move(presentation_callback),
+        std::nullopt, false);
+  } else {
+    ViewportResizeCallback superseded_callback =
+        std::move(viewport_resize_observation_->presentation_callback);
+    viewport_resize_observation_->presentation_callback =
+        std::move(presentation_callback);
+    viewport_resize_observation_->presentation_requested = false;
+    viewport_resize_observation_->activated_ack.reset();
+    if (superseded_callback) {
+      std::move(superseded_callback).Run(std::nullopt);
+    }
+  }
+
+  if (!viewport_resize_observation_ ||
+      viewport_resize_observation_->expected_size_in_dip !=
+          expected_size_in_dip) {
+    return false;
+  }
+
+  const cc::RenderFrameMetadata& metadata =
+      host()->render_frame_metadata_provider()->LastRenderFrameMetadata();
+  MaybeRequestViewportPresentation(metadata);
+  return true;
+}
+
+void RenderWidgetHostViewMac::CancelViewportResizeObservation() {
+  if (!viewport_resize_observation_) {
+    return;
+  }
+
+  ViewportResizeObservation observation =
+      std::move(*viewport_resize_observation_);
+  viewport_resize_observation_.reset();
+  if (observation.commit_callback) {
+    std::move(observation.commit_callback).Run(std::nullopt);
+  }
+  if (observation.presentation_callback) {
+    std::move(observation.presentation_callback).Run(std::nullopt);
+  }
+}
+
+gfx::Size RenderWidgetHostViewMac::ViewportSizeInPixels(
+    const gfx::Size& size_in_dip) const {
+  return gfx::ToRoundedSize(gfx::ConvertSizeToPixels(
+      size_in_dip, screen_infos_.current().device_scale_factor));
+}
+
+bool RenderWidgetHostViewMac::MetadataMatchesViewportResize(
+    const cc::RenderFrameMetadata& metadata) const {
+  return viewport_resize_observation_ && metadata.local_surface_id &&
+         metadata.local_surface_id->is_valid() &&
+         metadata.device_scale_factor ==
+             screen_infos_.current().device_scale_factor &&
+         metadata.viewport_size_in_pixels ==
+             viewport_resize_observation_->expected_size_in_pixels;
+}
+
+void RenderWidgetHostViewMac::MaybeAcknowledgeViewportResizeCommit(
+    const cc::RenderFrameMetadata& metadata) {
+  if (!MetadataMatchesViewportResize(metadata) ||
+      !viewport_resize_observation_->commit_callback) {
+    return;
+  }
+
+  ViewportResizeAck acknowledgement{
+      metadata.viewport_size_in_pixels, metadata.device_scale_factor,
+      *metadata.local_surface_id};
+  ViewportResizeCallback callback =
+      std::move(viewport_resize_observation_->commit_callback);
+  if (!viewport_resize_observation_->presentation_callback) {
+    viewport_resize_observation_.reset();
+  }
+  std::move(callback).Run(std::move(acknowledgement));
+}
+
+void RenderWidgetHostViewMac::MaybeRequestViewportPresentation(
+    const cc::RenderFrameMetadata& metadata) {
+  if (!MetadataMatchesViewportResize(metadata) ||
+      !viewport_resize_observation_->presentation_callback ||
+      viewport_resize_observation_->presentation_requested) {
+    return;
+  }
+
+  ui::Compositor* compositor = GetCompositor();
+  if (!compositor) {
+    CancelViewportResizeObservation();
+    return;
+  }
+
+  ViewportResizeAck acknowledgement{
+      metadata.viewport_size_in_pixels, metadata.device_scale_factor,
+      *metadata.local_surface_id};
+  viewport_resize_observation_->activated_ack = acknowledgement;
+  viewport_resize_observation_->presentation_requested = true;
+  compositor->RequestSuccessfulPresentationTimeForNextFrame(base::BindOnce(
+      &RenderWidgetHostViewMac::OnViewportPresented,
+      weak_factory_.GetWeakPtr(), acknowledgement));
+  compositor->ScheduleFullRedraw();
+}
+
+void RenderWidgetHostViewMac::OnViewportPresented(
+    ViewportResizeAck acknowledgement,
+    const viz::FrameTimingDetails& frame_timing_details) {
+  if (!viewport_resize_observation_ ||
+      !viewport_resize_observation_->activated_ack ||
+      viewport_resize_observation_->activated_ack->viewport_size_in_pixels !=
+          acknowledgement.viewport_size_in_pixels ||
+      viewport_resize_observation_->activated_ack->local_surface_id !=
+          acknowledgement.local_surface_id) {
+    return;
+  }
+
+  ViewportResizeCallback callback =
+      std::move(viewport_resize_observation_->presentation_callback);
+  viewport_resize_observation_.reset();
+  std::move(callback).Run(std::move(acknowledgement));
+}
