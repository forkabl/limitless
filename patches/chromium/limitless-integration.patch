+TEST_F(RenderWidgetHostViewMacTest, ViewportResizeCommitMatchesExpectedSurface) {
+  const gfx::Size expected_size_in_dip(320, 200);
+  const float device_scale_factor = rwhv_mac_->GetDeviceScaleFactor();
+  const gfx::Size expected_size_in_pixels = gfx::ToRoundedSize(
+      gfx::ConvertSizeToPixels(expected_size_in_dip, device_scale_factor));
+  const viz::LocalSurfaceId local_surface_id =
+      rwhv_mac_->GetLocalSurfaceId();
+  ASSERT_TRUE(local_surface_id.is_valid());
+
+  bool callback_called = false;
+  EXPECT_TRUE(rwhv_mac_->ObserveViewportResize(
+      expected_size_in_dip,
+      base::BindLambdaForTesting(
+          [&](std::optional<ViewportResizeAck> acknowledgement) {
+            callback_called = true;
+            ASSERT_TRUE(acknowledgement);
+            EXPECT_EQ(acknowledgement->viewport_size_in_pixels,
+                      expected_size_in_pixels);
+            EXPECT_EQ(acknowledgement->device_scale_factor,
+                      device_scale_factor);
+            EXPECT_EQ(acknowledgement->local_surface_id, local_surface_id);
+          }),
+      ViewportResizeCallback()));
+
+  cc::RenderFrameMetadata metadata;
+  metadata.viewport_size_in_pixels = gfx::Size(
+      expected_size_in_pixels.width() + 1, expected_size_in_pixels.height());
+  metadata.device_scale_factor = device_scale_factor;
+  metadata.local_surface_id = local_surface_id;
+  rwhv_mac_->OnRenderFrameMetadataChangedBeforeActivation(metadata);
+  EXPECT_FALSE(callback_called);
+
+  metadata.viewport_size_in_pixels = expected_size_in_pixels;
+  rwhv_mac_->OnRenderFrameMetadataChangedBeforeActivation(metadata);
+  EXPECT_TRUE(callback_called);
+}
