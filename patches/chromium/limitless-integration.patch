+TEST_F(RenderWidgetHostViewMacTest, CancellingViewportResizeResolvesCallbacks) {
+  int cancelled_callbacks = 0;
+  EXPECT_TRUE(rwhv_mac_->ObserveViewportResize(
+      gfx::Size(320, 200),
+      base::BindLambdaForTesting(
+          [&](std::optional<ViewportResizeAck> acknowledgement) {
+            EXPECT_FALSE(acknowledgement);
+            ++cancelled_callbacks;
+          }),
+      base::BindLambdaForTesting(
+          [&](std::optional<ViewportResizeAck> acknowledgement) {
+            EXPECT_FALSE(acknowledgement);
+            ++cancelled_callbacks;
