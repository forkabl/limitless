 namespace {
 
+#if defined(LIMITLESS_BUILD)
+
+std::string_view LimitlessResourcePath(const std::string& request_path) {
+  std::string_view resource_path(request_path);
+  return resource_path.substr(0, resource_path.find_first_of("?#"));
+}
+
+bool ShouldHandleLimitlessResource(const std::string& path) {
+  const std::string_view resource_path = LimitlessResourcePath(path);
+  return resource_path.empty() || resource_path == "limitless/app.css" ||
+         resource_path == "limitless/app.js";
+}
+
+void HandleLimitlessResource(
+    const std::string& path,
+    content::WebUIDataSource::GotDataCallback callback) {
+  const std::string_view resource_path = LimitlessResourcePath(path);
+  std::string_view response;
+  if (resource_path.empty()) {
+    response = limitless::resources::kWebUiBrowserHtml;
+  } else if (resource_path == "limitless/app.css") {
+    response = limitless::resources::kAppCss;
+  } else {
+    response = limitless::resources::kAppJavaScript;
+  }
+
+  std::move(callback).Run(
+      base::MakeRefCounted<base::RefCountedString>(std::string(response)));
+}
+
+#endif  // defined(LIMITLESS_BUILD)
+
 std::string SidePanelEntryIdToTitle(SidePanelEntryId id) {
