+std::optional<split_tabs::SplitTabVisualData> RestoreSplitVisualData(
+    const std::vector<split_tabs::SplitTabVisualData>& updates,
+    std::string_view serialized_layout_override = {}) {
+  const SessionID window_id = SessionID::NewUnique();
+  const split_tabs::SplitTabId split_id = split_tabs::SplitTabId::GenerateNew();
+  std::vector<std::unique_ptr<SessionCommand>> commands;
+  commands.push_back(CreateSetWindowTypeCommand(
+      window_id, SessionWindow::WindowType::TYPE_NORMAL));
+  commands.push_back(CreateSetSelectedTabInWindowCommand(window_id, 0));
+
+  for (int index = 0; index < 2; ++index) {
+    const SessionID tab_id = SessionID::NewUnique();
+    const SerializedNavigationEntry navigation =
+        SerializedNavigationEntryTestHelper::CreateNavigationForTest();
+    commands.push_back(CreateSetTabWindowCommand(window_id, tab_id));
+    commands.push_back(CreateSetTabIndexInWindowCommand(tab_id, index));
+    commands.push_back(CreateUpdateTabNavigationCommand(tab_id, navigation));
+    commands.push_back(
+        CreateSetSelectedNavigationIndexCommand(tab_id, navigation.index()));
+    commands.push_back(CreateSplitTabCommand(tab_id, split_id));
+  }
+
+  for (const split_tabs::SplitTabVisualData& update : updates) {
+    if (serialized_layout_override.empty()) {
+      commands.push_back(CreateSplitTabDataUpdateCommand(split_id, &update));
+      continue;
+    }
+
+    base::Pickle pickle;
+    base::WriteTokenToPickle(&pickle, split_id.token());
+    pickle.WriteDouble(update.split_ratio());
+    pickle.WriteString(serialized_layout_override);
+    const SessionCommand::id_type command_id =
+        CreateSplitTabDataUpdateCommand(split_id, &update)->id();
+    commands.push_back(std::make_unique<SessionCommand>(command_id, pickle));
+  }
+
+  std::vector<std::unique_ptr<SessionWindow>> windows;
+  SessionID active_window_id = SessionID::InvalidValue();
+  std::string platform_session_id;
+  std::set<SessionID> discarded_window_ids;
+  RestoreSessionFromCommands(commands, &windows, &active_window_id,
+                             &platform_session_id, &discarded_window_ids);
+  if (windows.size() != 1u || windows[0]->split_tabs.size() != 1u ||
+      windows[0]->split_tabs[0]->id_ != split_id) {
+    return std::nullopt;
+  }
+  return windows[0]->split_tabs[0]->split_visual_data_;
+}
+
+TEST(SessionServiceCommandsTest, InvalidSplitRatiosUseDefaultVisualData) {
+  const std::vector<double> invalid_ratios = {
+      std::numeric_limits<double>::quiet_NaN(),
+      std::numeric_limits<double>::infinity(),
+      -std::numeric_limits<double>::infinity(),
+      -0.01,
+      1.01,
+  };
+
+  for (double invalid_ratio : invalid_ratios) {
+    SCOPED_TRACE(invalid_ratio);
+    const std::optional<split_tabs::SplitTabVisualData> restored =
+        RestoreSplitVisualData({split_tabs::SplitTabVisualData(
+            split_tabs::SplitTabLayout::kStacked, invalid_ratio)});
+    ASSERT_TRUE(restored.has_value());
+    EXPECT_EQ(split_tabs::SplitTabVisualData(), *restored);
+  }
+}
+
+TEST(SessionServiceCommandsTest, InvalidSplitRatiosPreservePreviousValidData) {
+  const split_tabs::SplitTabVisualData valid(
+      split_tabs::SplitTabLayout::kStacked, 0.25);
+  const std::vector<double> invalid_ratios = {
+      std::numeric_limits<double>::quiet_NaN(),
+      std::numeric_limits<double>::infinity(),
+      -std::numeric_limits<double>::infinity(),
+      -0.01,
+      1.01,
+  };
+
+  for (double invalid_ratio : invalid_ratios) {
+    SCOPED_TRACE(invalid_ratio);
+    const std::optional<split_tabs::SplitTabVisualData> restored =
+        RestoreSplitVisualData(
+            {valid,
+             split_tabs::SplitTabVisualData(
+                 split_tabs::SplitTabLayout::kSideBySide, invalid_ratio)});
+    ASSERT_TRUE(restored.has_value());
+    EXPECT_EQ(valid, *restored);
+  }
+}
+
+TEST(SessionServiceCommandsTest, InvalidSplitRatiosDoNotStopLaterCommands) {
+  const split_tabs::SplitTabVisualData valid(
+      split_tabs::SplitTabLayout::kStacked, 0.75);
+  const std::vector<double> invalid_ratios = {
+      std::numeric_limits<double>::quiet_NaN(),
+      std::numeric_limits<double>::infinity(),
+      -std::numeric_limits<double>::infinity(),
+      -0.01,
+      1.01,
+  };
+
+  for (double invalid_ratio : invalid_ratios) {
+    SCOPED_TRACE(invalid_ratio);
+    const std::optional<split_tabs::SplitTabVisualData> restored =
+        RestoreSplitVisualData(
+            {split_tabs::SplitTabVisualData(
+                 split_tabs::SplitTabLayout::kSideBySide, invalid_ratio),
+             valid});
+    ASSERT_TRUE(restored.has_value());
+    EXPECT_EQ(valid, *restored);
+  }
+}
+
+TEST(SessionServiceCommandsTest, SplitRatioEndpointsAreValid) {
+  const std::vector<split_tabs::SplitTabVisualData> endpoints = {
+      split_tabs::SplitTabVisualData(split_tabs::SplitTabLayout::kStacked, 0.0),
+      split_tabs::SplitTabVisualData(split_tabs::SplitTabLayout::kSideBySide,
+                                     1.0),
+  };
+
+  for (const split_tabs::SplitTabVisualData& endpoint : endpoints) {
+    const std::optional<split_tabs::SplitTabVisualData> restored =
+        RestoreSplitVisualData({endpoint});
+    ASSERT_TRUE(restored.has_value());
+    EXPECT_EQ(endpoint, *restored);
+  }
+}
+
+TEST(SessionServiceCommandsTest,
+     UnknownSplitLayoutPreservesRatioAndUsesSideBySide) {
+  const std::optional<split_tabs::SplitTabVisualData> restored =
+      RestoreSplitVisualData({split_tabs::SplitTabVisualData(
+                                 split_tabs::SplitTabLayout::kStacked, 0.3)},
+                             "unknown-layout");
+
+  ASSERT_TRUE(restored.has_value());
+  EXPECT_EQ(split_tabs::SplitTabVisualData(
+                split_tabs::SplitTabLayout::kSideBySide, 0.3),
+            *restored);
+}
