config("preference_control_public") {
  include_dirs = [ "." ]
}

source_set("preference_control") {
  sources = [
    "limitless_preference_control_service.cc",
    "limitless_preference_control_service.h",
  ]

  public_deps = [ "//base" ]
  public_configs = [ ":preference_control_public" ]
}

source_set("preference_control_protocol") {
  sources = [
    "limitless_preference_control_protocol.cc",
    "limitless_preference_control_protocol.h",
  ]

  public_deps = [ ":preference_control" ]
  public_configs = [ ":preference_control_public" ]
  deps = [ "//base" ]
}

config("profile_prefs_public") {
  defines = [ "LIMITLESS_PROFILE_PREFS_ENABLED" ]
  include_dirs = [ "." ]
}

source_set("profile_prefs") {
  sources = [
    "limitless_profile_prefs.cc",
    "limitless_profile_prefs.h",
  ]

  public_deps = [ "//components/pref_registry" ]
  public_configs = [ ":profile_prefs_public" ]
}

source_set("profile_preference_backend") {
  sources = [
    "limitless_profile_preference_backend.cc",
    "limitless_profile_preference_backend.h",
  ]

  public_deps = [
    ":preference_control",
    ":profile_prefs",
    "//base",
  ]
  public_configs = [ ":preference_control_public" ]

  deps = [
    "//chrome/browser/profiles",
    "//components/prefs",
    "//crypto",
  ]
}

source_set("running_profile_control_registry") {
  sources = [
    "limitless_running_profile_control_registry.cc",
    "limitless_running_profile_control_registry.h",
  ]

  public_deps = [
    ":preference_control_transport",
    ":profile_preference_backend",
    "//base",
  ]
  public_configs = [ ":preference_control_public" ]

  deps = [
    "../commands:command_window_registry",
    "//chrome/browser/profiles",
    "//chrome/browser/ui/browser_window",
  ]
}

source_set("preference_control_transport") {
  sources = [
    "limitless_preference_control_transport.cc",
    "limitless_preference_control_transport.h",
  ]

  public_deps = [
    ":profile_preference_backend",
    "//base",
  ]
  public_configs = [ ":preference_control_public" ]
  deps = [
    ":preference_control",
    ":preference_control_protocol",
    ":preference_control_transport_worker",
  ]
}

source_set("preference_control_transport_worker") {
  sources = [
    "limitless_preference_control_transport_worker.cc",
    "limitless_preference_control_transport_worker.h",
  ]
  public_deps = [ "//base" ]
  public_configs = [ ":preference_control_public" ]
  deps = [
    ":preference_control",
    ":preference_control_protocol",
  ]
}
