import("//ui/webui/resources/tools/build_webui.gni")

assert(is_mac && current_cpu == "arm64",
       "The Phase 1 Limitless shell resources support macOS arm64 only.")

build_webui("build") {
  grd_prefix = "limitless_shell"
  generate_grdp = true

  static_files = [
    "app.css",
    "webui_browser.html",
  ]

  ts_files = [ "app.ts" ]
}

_embedded_header = "$target_gen_dir/limitless_shell_resources.h"

action("generate_embedded_resources") {
  script = "../../build/chromium/embed_webui_resources.py"

  _html = "webui_browser.html"
  _css = "app.css"
  _javascript = "app.ts"

  inputs = [
    _css,
    _html,
    _javascript,
  ]
  outputs = [ _embedded_header ]

  args = [
    "--output",
    rebase_path(_embedded_header, root_build_dir),
    "--resource",
    "kWebUiBrowserHtml=" + rebase_path(_html, root_build_dir),
    "--resource",
    "kAppCss=" + rebase_path(_css, root_build_dir),
    "--resource",
    "kAppJavaScript=" + rebase_path(_javascript, root_build_dir),
  ]

  deps = [ ":build_grdp" ]
}

config("generated_resource_include") {
  include_dirs = [ target_gen_dir ]
}

source_set("resources") {
  sources = [ _embedded_header ]
  public_configs = [ ":generated_resource_include" ]
  public_deps = [ ":generate_embedded_resources" ]
}
