#!/usr/bin/env python3
"""Authenticated local control client for a running Limitless profile."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import socket
import stat
import struct
import sys
import uuid
from collections.abc import Callable


PROTOCOL_VERSION = 1
RUNTIME_DIRECTORY = "LimitlessControl"
MAXIMUM_REQUEST_BYTES = 16 * 1024
MAXIMUM_RESPONSE_BYTES = 32 * 1024
IO_TIMEOUT_SECONDS = 2.0


class ControlError(Exception):
    def __init__(self, code: str, detail: str | None = None) -> None:
        super().__init__(code)
        self.code = code
        self.detail = detail


def _reject_duplicate_keys(pairs: list[tuple[str, object]]) -> dict[str, object]:
    result: dict[str, object] = {}
    for key, item in pairs:
        if key in result:
            raise ValueError("duplicate key")
        result[key] = item
    return result


def _verify_peer_pid(connection: socket.socket, expected_pid: int) -> None:
    try:
        peer_pid = struct.unpack("=i", connection.getsockopt(0, 0x002, 4))[0]
    except (OSError, struct.error) as error:
        raise ControlError("peer_identity_unavailable") from error
    if peer_pid != expected_pid:
        raise ControlError("peer_identity_mismatch")


def _canonical_uuid(value: object) -> bool:
    if not isinstance(value, str):
        return False
    try:
        return str(uuid.UUID(value)) == value
    except ValueError:
        return False


def _open_directory(path: Path, missing_code: str = "unsafe_discovery_entry") -> int:
    fd = -1
    try:
        fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
        metadata = os.fstat(fd)
    except OSError as error:
        if fd >= 0:
            os.close(fd)
        if isinstance(error, FileNotFoundError):
            raise ControlError(missing_code, str(error)) from error
        raise ControlError("unsafe_discovery_entry", str(error)) from error
    if not stat.S_ISDIR(metadata.st_mode) or metadata.st_uid != os.geteuid():
        os.close(fd)
        raise ControlError("unsafe_discovery_entry")
    if stat.S_IMODE(metadata.st_mode) != 0o700:
        os.close(fd)
        raise ControlError("unsafe_discovery_permissions")
    return fd


def _read_fd(fd: int, maximum: int) -> bytes:
    chunks = bytearray()
    while len(chunks) <= maximum:
        try:
            piece = os.read(fd, min(4096, maximum + 1 - len(chunks)))
        except OSError as error:
            raise ControlError("invalid_descriptor", str(error)) from error
        if not piece:
            return bytes(chunks)
        chunks.extend(piece)
    raise ControlError("invalid_descriptor")


def _open_checked_at(
    directory_fd: int,
    name: str,
    expected_type: Callable[[int], bool],
    maximum: int,
) -> tuple[int, bytes]:
    if expected_type is stat.S_ISSOCK:
        try:
            metadata = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
        except OSError as error:
            if isinstance(error, FileNotFoundError):
                raise ControlError("invalid_descriptor") from error
            raise ControlError("unsafe_discovery_entry", str(error)) from error
        if not stat.S_ISSOCK(metadata.st_mode) or metadata.st_uid != os.geteuid():
            raise ControlError("unsafe_discovery_entry")
        if stat.S_IMODE(metadata.st_mode) != 0o600:
            raise ControlError("unsafe_discovery_permissions")
        return -1, b""
    fd = -1
    try:
        fd = os.open(
            name, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=directory_fd
        )
        metadata = os.fstat(fd)
    except OSError as error:
        if fd >= 0:
            os.close(fd)
        if isinstance(error, FileNotFoundError):
            raise ControlError("invalid_descriptor") from error
        raise ControlError("unsafe_discovery_entry", str(error)) from error
    if not expected_type(metadata.st_mode) or metadata.st_uid != os.geteuid():
        os.close(fd)
        raise ControlError("unsafe_discovery_entry")
    if stat.S_IMODE(metadata.st_mode) != 0o600:
        os.close(fd)
        raise ControlError("unsafe_discovery_permissions")
    try:
        return fd, _read_fd(fd, maximum)
    except Exception:
        os.close(fd)
        raise


def _read_descriptor(
    path: Path, runtime: Path, runtime_fd: int
) -> tuple[dict[str, object] | None, tuple[str, str] | None]:
    try:
        descriptor_fd, descriptor_bytes = _open_checked_at(
            runtime_fd, path.name, stat.S_ISREG, 4096
        )
        os.close(descriptor_fd)
        value = json.loads(
            descriptor_bytes.decode("utf-8"), object_pairs_hook=_reject_duplicate_keys
        )
    except (UnicodeError, json.JSONDecodeError, ValueError, RecursionError) as error:
        raise ControlError("invalid_descriptor", str(error)) from error
    expected = {
        "version",
        "profile_id",
        "instance_id",
        "socket_path",
        "credential_path",
        "pid",
    }
    if not isinstance(value, dict):
        raise ControlError("invalid_descriptor")
    if (
        "version" not in value
        or not isinstance(value["version"], int)
        or isinstance(value["version"], bool)
    ):
        raise ControlError("invalid_descriptor")
    if not isinstance(value.get("profile_id"), str) or not isinstance(
        value.get("instance_id"), str
    ):
        raise ControlError("invalid_descriptor")
    if not _canonical_uuid(value["profile_id"]) or not _canonical_uuid(
        value["instance_id"]
    ):
        raise ControlError("invalid_descriptor")
    endpoint_stem = f'{value["profile_id"]}.{value["instance_id"]}'
    if path.name != f"{endpoint_stem}.json":
        raise ControlError("invalid_descriptor")
    pid = value.get("pid")
    if (
        not isinstance(pid, int)
        or isinstance(pid, bool)
        or pid <= 0
        or pid > 2**31 - 1
    ):
        raise ControlError("invalid_descriptor")
    try:
        os.kill(pid, 0)
    except ProcessLookupError as error:
        raise ControlError("stale_instance") from error
    except PermissionError as error:
        raise ControlError("unsafe_discovery_entry") from error
    if value["version"] != PROTOCOL_VERSION:
        return None, (value["profile_id"], value["instance_id"])
    if set(value) != expected:
        raise ControlError("invalid_descriptor")
    for field in ("socket_path", "credential_path"):
        raw = value[field]
        if not isinstance(raw, str) or not raw or "\x00" in raw:
            raise ControlError("invalid_descriptor")
    socket_path = Path(value["socket_path"])
    local_socket_name = f's-{value["profile_id"][:12]}-{value["instance_id"]}'
    socket_in_runtime = (
        socket_path.parent == runtime
        and socket_path.name
        == f'{value["profile_id"][:8]}-{value["instance_id"][:8]}.sock'
    )
    fallback_parent = Path(f"/tmp/limitless-{os.geteuid()}")
    socket_in_short_fallback = (
        socket_path.parent == fallback_parent and socket_path.name == local_socket_name
    )
    if not socket_in_runtime and not socket_in_short_fallback:
        raise ControlError("invalid_descriptor")
    socket_parent = runtime if socket_in_runtime else fallback_parent
    socket_parent_fd = (
        runtime_fd
        if socket_in_runtime
        else _open_directory(socket_parent, missing_code="invalid_descriptor")
    )
    try:
        socket_fd, _ = _open_checked_at(
            socket_parent_fd, socket_path.name, stat.S_ISSOCK, 0
        )
        if socket_fd >= 0:
            os.close(socket_fd)
    finally:
        if socket_parent_fd != runtime_fd:
            os.close(socket_parent_fd)
    credential_path = Path(value["credential_path"])
    if (
        credential_path.parent != runtime
        or credential_path.name != f"{endpoint_stem}.token"
    ):
        raise ControlError("invalid_descriptor")
    credential_fd, _ = _open_checked_at(
        runtime_fd, credential_path.name, stat.S_ISREG, 256
    )
    os.close(credential_fd)
    return value, None


def _descriptors(
    runtime: Path, runtime_fd: int
) -> tuple[list[dict[str, object]], set[tuple[str, str]]]:
    descriptors: list[dict[str, object]] = []
    incompatible: set[tuple[str, str]] = set()
    try:
        names = sorted(
            name for name in os.listdir(runtime_fd) if name.endswith(".json")
        )
    except FileNotFoundError:
        return [], incompatible
    except OSError as error:
        raise ControlError("discovery_unavailable", str(error)) from error
    for name in names:
        path = runtime / name
        try:
            descriptor, target = _read_descriptor(path, runtime, runtime_fd)
            if descriptor is not None:
                descriptors.append(descriptor)
            if target is not None:
                incompatible.add(target)
        except ControlError as error:
            if error.code not in {"stale_instance", "invalid_descriptor"}:
                raise
    return descriptors, incompatible


def _select_descriptor(
    runtime: Path,
    runtime_fd: int,
    profile_identifier: str | None,
    instance_identifier: str | None,
) -> dict[str, object]:
    matches, incompatible = _descriptors(runtime, runtime_fd)
    if profile_identifier is not None:
        if not _canonical_uuid(profile_identifier):
            raise ControlError("invalid_profile")
        matches = [
            entry for entry in matches if entry["profile_id"] == profile_identifier
        ]
    if instance_identifier is not None:
        if not _canonical_uuid(instance_identifier):
            raise ControlError("invalid_instance")
        matches = [
            entry for entry in matches if entry["instance_id"] == instance_identifier
        ]
    candidate_incompatible = [
        target
        for target in incompatible
        if (profile_identifier is None or target[0] == profile_identifier)
        and (instance_identifier is None or target[1] == instance_identifier)
    ]
    if not matches and len(candidate_incompatible) == 1:
        raise ControlError("incompatible_version")
    if len(matches) + len(candidate_incompatible) > 1:
        raise ControlError("ambiguous_profile")
    if not matches:
        raise ControlError("profile_unavailable")
    if len(matches) != 1:
        raise ControlError("ambiguous_profile")
    return matches[0]


def _read_exact(connection: socket.socket, size: int) -> bytes:
    result = bytearray()
    while len(result) < size:
        piece = connection.recv(size - len(result))
        if not piece:
            raise ControlError("transport_closed")
        result.extend(piece)
    return bytes(result)


def _exchange(descriptor: dict[str, object], request: dict[str, object]) -> object:
    encoded = json.dumps(request, separators=(",", ":")).encode("utf-8")
    if not encoded or len(encoded) > MAXIMUM_REQUEST_BYTES:
        raise ControlError("request_oversized")
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
            connection.settimeout(IO_TIMEOUT_SECONDS)
            connection.connect(str(descriptor["socket_path"]))
            _verify_peer_pid(connection, int(descriptor["pid"]))
            connection.sendall(struct.pack("!I", len(encoded)) + encoded)
            response_size = struct.unpack("!I", _read_exact(connection, 4))[0]
            if response_size == 0 or response_size > MAXIMUM_RESPONSE_BYTES:
                raise ControlError("invalid_response")
            response = _read_exact(connection, response_size)
    except socket.timeout as error:
        raise ControlError("transport_timeout") from error
    except OSError as error:
        raise ControlError("transport_unavailable", str(error)) from error
    try:
        return json.loads(response)
    except (UnicodeError, json.JSONDecodeError) as error:
        raise ControlError("invalid_response") from error


def _preference_request(
    descriptor: dict[str, object],
    capability: str,
    operation: str,
    key: str,
    value: str | None,
) -> dict[str, object]:
    request: dict[str, object] = {
        "version": PROTOCOL_VERSION,
        "request_id": str(uuid.uuid4()),
        "operation": operation,
        "target": {
            "profile_id": descriptor["profile_id"],
            "instance_id": descriptor["instance_id"],
        },
        "actor": {"type": "cli", "id": f"limitlessctl:{os.getpid()}"},
        "authentication": {
            "scheme": "capability",
            "credential": capability,
        },
        "key": key,
    }
    if value is not None:
        request["value"] = value
    return request


def _read_capability(descriptor: dict[str, object], runtime_fd: int) -> str:
    fd = -1
    try:
        fd, data = _open_checked_at(
            runtime_fd, Path(descriptor["credential_path"]).name, stat.S_ISREG, 256
        )
        capability = data.decode("utf-8")
    except ControlError as error:
        if error.code in {"unsafe_discovery_entry", "unsafe_discovery_permissions"}:
            raise
        raise ControlError("capability_unavailable") from error
    except UnicodeError as error:
        raise ControlError("capability_unavailable") from error
    finally:
        if fd >= 0:
            os.close(fd)
    if (
        not capability
        or len(capability.encode("utf-8")) > 256
        or any(
            ord(character) < 0x20 or ord(character) == 0x7F for character in capability
        )
    ):
        raise ControlError("capability_unavailable")
    return capability


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="limitlessctl")
    parser.add_argument("--user-data-dir", type=Path, required=True)
    parser.add_argument("--profile")
    parser.add_argument("--instance")
    subcommands = parser.add_subparsers(dest="command", required=True)
    subcommands.add_parser("discover")
    preferences = subcommands.add_parser("preferences")
    preference_commands = preferences.add_subparsers(
        dest="preference_command", required=True
    )
    get = preference_commands.add_parser("get")
    get.add_argument("key", choices=["rail_density"])
    set_value = preference_commands.add_parser("set")
    set_value.add_argument("key", choices=["rail_density"])
    set_value.add_argument("value", choices=["compact", "comfortable"])
    return parser


def _emit(value: object) -> None:
    print(json.dumps(value, separators=(",", ":"), sort_keys=True))


def main(argv: list[str]) -> int:
    arguments = _parser().parse_args(argv)
    try:
        if arguments.command == "discover":
            runtime = arguments.user_data_dir / RUNTIME_DIRECTORY
            runtime_fd = _open_directory(runtime, missing_code="discovery_unavailable")
            try:
                entries, _ = _descriptors(runtime, runtime_fd)
            finally:
                os.close(runtime_fd)
            _emit(
                {
                    "version": PROTOCOL_VERSION,
                    "status": "success",
                    "profiles": [
                        {
                            "profile_id": entry["profile_id"],
                            "instance_id": entry["instance_id"],
                            "pid": entry["pid"],
                        }
                        for entry in entries
                    ],
                }
            )
            return 0
        runtime = arguments.user_data_dir / RUNTIME_DIRECTORY
        runtime_fd = _open_directory(runtime, missing_code="discovery_unavailable")
        try:
            descriptor = _select_descriptor(
                runtime, runtime_fd, arguments.profile, arguments.instance
            )
            capability = _read_capability(descriptor, runtime_fd)
            operation = "read" if arguments.preference_command == "get" else "write"
            value = getattr(arguments, "value", None)
            result = _exchange(
                descriptor,
                _preference_request(
                    descriptor, capability, operation, arguments.key, value
                ),
            )
        finally:
            os.close(runtime_fd)
        _emit(result)
        return (
            0 if isinstance(result, dict) and result.get("status") == "success" else 3
        )
    except ControlError as error:
        result: dict[str, object] = {
            "version": PROTOCOL_VERSION,
            "status": "error",
            "error": error.code,
        }
        _emit(result)
        return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
