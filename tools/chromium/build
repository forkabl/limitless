#!/usr/bin/env python3
"""Build deterministic Limitless Chromium targets with autoninja."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.dont_write_bytecode = True

from _common import (
    Paths,
    ToolError,
    command_text,
    require_file,
    require_generated_args,
    validate_targets,
    verify_integration,
    run,
)


DEFAULT_TARGETS = ("chrome", "browser_tests", "interactive_ui_tests")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="validate and print the command without building",
    )
    parser.add_argument(
        "targets",
        nargs="*",
        help="Ninja targets; defaults to chrome and the two browser test suites",
    )
    args = parser.parse_args()

    paths = Paths.discover(Path(__file__))
    verify_integration(paths)
    require_file(paths.autoninja, "workspace depot_tools autoninja", executable=True)
    require_generated_args(paths)
    targets = validate_targets(args.targets or DEFAULT_TARGETS)
    command = [paths.autoninja, "-C", paths.out_dir, *targets]

    if args.dry_run:
        print(f"Would run: {command_text(command)}")
        print("No build output was modified.")
        return 0

    require_file(paths.out_dir / "build.ninja", "generated Limitless Ninja graph")
    print(f"Running: {command_text(command)}")
    run(command, cwd=paths.chromium_src, capture=False)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except ToolError as error:
        print(f"error: {error}", file=sys.stderr)
        raise SystemExit(2)
