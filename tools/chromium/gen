#!/usr/bin/env python3
"""Generate the deterministic macOS arm64 Limitless GN configuration."""

from __future__ import annotations

import argparse
import os
import sys
import tempfile
from pathlib import Path

sys.dont_write_bytecode = True

from _common import (
    Paths,
    ToolError,
    command_text,
    rendered_args,
    require_generation_inputs,
    verify_integration,
    run,
)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="validate inputs and print the write and command without changing output",
    )
    args = parser.parse_args()

    paths = Paths.discover(Path(__file__))
    verification = verify_integration(paths)
    require_generation_inputs(paths)
    content = rendered_args(paths)
    command = [paths.gn, "gen", paths.out_dir, "--check"]

    if args.dry_run:
        print(f"Would write deterministic GN args to {paths.args_file}:")
        print(content, end="")
        print(f"Would run: {command_text(command)}")
        print(
            f"Validated Chromium {verification.chromium_state} state at "
            f"{verification.pin}. No output was modified."
        )
        return 0

    paths.out_dir.mkdir(parents=True, exist_ok=True)
    file_descriptor, temporary_name = tempfile.mkstemp(
        prefix=".args.gn.", dir=paths.out_dir, text=True
    )
    try:
        with os.fdopen(file_descriptor, "w", encoding="utf-8", newline="\n") as output:
            output.write(content)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary_name, paths.args_file)
    finally:
        if os.path.exists(temporary_name):
            os.unlink(temporary_name)

    print(f"Wrote {paths.args_file}")
    print(f"Running: {command_text(command)}")
    run(command, cwd=paths.chromium_src, capture=False)
    print(f"Generated and checked {paths.out_dir}")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except ToolError as error:
        print(f"error: {error}", file=sys.stderr)
        raise SystemExit(2)
