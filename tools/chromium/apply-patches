#!/usr/bin/env python3
"""Strictly check or apply the ordered, hashed Chromium patch series."""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.dont_write_bytecode = True

from _common import (
    Paths,
    ToolError,
    _strict_apply,
    expected_patched_entries,
    inspect_chromium_state,
    print_verification,
    verify,
)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--check",
        "--dry-run",
        dest="check_only",
        action="store_true",
        help="validate the complete series without changing Chromium",
    )
    args = parser.parse_args()

    paths = Paths.discover(Path(__file__))
    verification = verify(paths, require_state="clean")
    print_verification(verification, paths)

    # This uses a temporary index and temporary object directory. It proves the
    # entire ordered series before the real worktree is touched.
    expected_patched_entries(paths, verification.manifest)
    if args.check_only:
        print("Patch check succeeded. Chromium was not modified.")
        return 0

    if not verification.manifest.patches:
        print("Patch series is empty. Nothing to apply.")
        return 0

    for entry in verification.manifest.patches:
        patch_path = paths.patches_dir / entry.file
        _strict_apply(paths, patch_path, check_only=True)
        _strict_apply(paths, patch_path)
        print(f"Applied {entry.file}")

    state, status = inspect_chromium_state(paths, verification.manifest)
    if state != "patched":
        raise ToolError(
            "Patch commands completed, but Chromium did not match the exact "
            f"recorded state. Current status:\n{status}"
        )
    print("Patch series applied and verified exactly.")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except ToolError as error:
        print(f"error: {error}", file=sys.stderr)
        print(
            "No reset or cleanup was attempted. Inspect the Chromium worktree "
            "before taking any corrective action.",
            file=sys.stderr,
        )
        raise SystemExit(2)
