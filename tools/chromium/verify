#!/usr/bin/env python3
"""Verify the exact Chromium pin, manifest, hashes, and worktree state."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

sys.dont_write_bytecode = True

from _common import Paths, ToolError, print_verification, verify


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    state = parser.add_mutually_exclusive_group()
    state.add_argument(
        "--require-clean",
        action="store_true",
        help="fail unless Chromium has no tracked or untracked changes",
    )
    state.add_argument(
        "--require-patched",
        action="store_true",
        help="fail unless Chromium exactly matches the recorded patch series",
    )
    parser.add_argument(
        "--json", action="store_true", help="emit machine-readable verification output"
    )
    args = parser.parse_args()

    required = None
    if args.require_clean:
        required = "clean"
    elif args.require_patched:
        required = "patched"

    paths = Paths.discover(Path(__file__))
    result = verify(paths, require_state=required)
    if args.json:
        print(
            json.dumps(
                {
                    "limitless_root": str(paths.limitless_root),
                    "chromium_root": str(paths.chromium_src),
                    "pin": result.pin,
                    "chromium_head": result.chromium_head,
                    "patch_count": len(result.manifest.patches),
                    "chromium_state": result.chromium_state,
                    "limitless_status": result.limitless_status,
                    "chromium_status": result.chromium_status,
                },
                sort_keys=True,
            )
        )
    else:
        print_verification(result, paths)
        print("Verification succeeded.")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except ToolError as error:
        print(f"error: {error}", file=sys.stderr)
        raise SystemExit(2)
