#!/usr/bin/env python3
"""Generate one prospective Chromium patch from an explicit path allowlist."""

from __future__ import annotations

import argparse
import hashlib
import sys
from pathlib import Path

sys.dont_write_bytecode = True

from _common import (  # noqa: E402
    PATCH_NAME_RE,
    Paths,
    ToolError,
    _nul_names,
    _patch_paths_from_numstat,
    _safe_upstream_path,
    _strict_apply,
    chromium_head,
    ensure_supported_host,
    git,
    load_manifest,
    populate_temporary_index,
    read_pin,
    run,
    temporary_git_index,
)


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Generate a patch relative to the complete recorded Chromium patch "
            "series without modifying Chromium, the manifest, or the series."
        )
    )
    parser.add_argument(
        "--name",
        required=True,
        help="Prospective patch basename, such as 0002-feature-name.patch.",
    )
    parser.add_argument(
        "--path",
        action="append",
        dest="candidate_paths",
        required=True,
        help="Chromium-relative candidate path. Repeat for every intended path.",
    )
    output_mode = parser.add_mutually_exclusive_group(required=True)
    output_mode.add_argument(
        "--check",
        action="store_true",
        help="Validate and summarize the prospective patch without writing it.",
    )
    output_mode.add_argument(
        "--write",
        action="store_true",
        help="Create the patch file exclusively, without updating metadata.",
    )
    return parser.parse_args()


def candidate_changed_from_baseline(
    paths: Paths,
    relative_path: str,
    environment: dict[str, str],
) -> bool:
    """Return whether one candidate differs between the baseline index and disk."""
    listed = run(
        ["git", "ls-files", "--error-unmatch", "--", relative_path],
        cwd=paths.chromium_src,
        env=environment,
        check=False,
    )
    if listed.returncode not in (0, 1):
        raise ToolError(f"Could not inspect candidate path: {relative_path}")
    baseline_has_path = listed.returncode == 0
    absolute_path = paths.chromium_src / relative_path
    worktree_has_path = absolute_path.exists() or absolute_path.is_symlink()
    if baseline_has_path != worktree_has_path:
        return True
    if not baseline_has_path:
        return False

    comparison = run(
        ["git", "diff", "--quiet", "--", relative_path],
        cwd=paths.chromium_src,
        env=environment,
        check=False,
    )
    if comparison.returncode not in (0, 1):
        raise ToolError(f"Could not compare candidate path: {relative_path}")
    return comparison.returncode == 1


def require_recorded_paths_at_baseline(
    paths: Paths,
    recorded_paths: set[str],
    candidate_paths: set[str],
    environment: dict[str, str],
) -> None:
    mismatches: list[str] = []
    for relative_path in sorted(recorded_paths - candidate_paths):
        comparison = run(
            ["git", "diff", "--quiet", "--", relative_path],
            cwd=paths.chromium_src,
            env=environment,
            check=False,
        )
        if comparison.returncode == 1:
            mismatches.append(relative_path)
        elif comparison.returncode != 0:
            raise ToolError(f"Could not compare recorded path: {relative_path}")
    if mismatches:
        raise ToolError(
            "Recorded patch paths outside the candidate allowlist do not match "
            "the complete recorded series:\n" + "\n".join(mismatches)
        )


def generate() -> int:
    arguments = parse_arguments()
    paths = Paths.discover(Path(__file__))

    if not PATCH_NAME_RE.fullmatch(arguments.name):
        raise ToolError(f"Invalid prospective patch basename: {arguments.name!r}")
    output_path = paths.patches_dir / arguments.name
    if output_path.exists() or output_path.is_symlink():
        raise ToolError(f"Refusing to overwrite existing patch: {output_path}")

    raw_candidates: list[str] = arguments.candidate_paths
    if len(set(raw_candidates)) != len(raw_candidates):
        raise ToolError("Candidate path allowlist contains duplicate values.")
    for index, relative_path in enumerate(raw_candidates, start=1):
        _safe_upstream_path(relative_path, f"candidate path {index}")
        if relative_path in ("", ".") or relative_path != relative_path.strip():
            raise ToolError(
                f"candidate path {index} is not a safe Chromium-relative path: "
                f"{relative_path!r}"
            )
        absolute_path = paths.chromium_src / relative_path
        if absolute_path.is_dir():
            raise ToolError(
                f"Candidate path must name a file, not a directory: {relative_path}"
            )
    candidates = tuple(sorted(raw_candidates))
    candidate_set = set(candidates)

    ensure_supported_host()
    pin = read_pin(paths)
    head = chromium_head(paths)
    if head != pin:
        raise ToolError(
            "Chromium HEAD does not match chromium.version.\n"
            f"expected: {pin}\nactual:   {head}"
        )
    manifest = load_manifest(paths, pin)
    if arguments.name in {entry.file for entry in manifest.patches}:
        raise ToolError(f"Patch is already recorded in the manifest: {arguments.name}")
    expected_number = len(manifest.patches) + 1
    if int(arguments.name[:4]) != expected_number:
        raise ToolError(
            f"Prospective patch must use sequence {expected_number:04d} after the "
            f"recorded series: {arguments.name}"
        )

    staged = git(paths, ["diff", "--cached", "--quiet"], check=False)
    if staged.returncode not in (0, 1):
        raise ToolError("Could not inspect staged Chromium changes.")
    if staged.returncode == 1:
        raise ToolError(
            "Chromium has staged changes. Unstage them before generating a patch."
        )

    tracked = _nul_names(git(paths, ["diff", "--name-only", "-z", "HEAD"]))
    untracked = _nul_names(
        git(paths, ["ls-files", "--others", "--exclude-standard", "-z"])
    )
    recorded_paths = {
        relative_path
        for entry in manifest.patches
        for relative_path in entry.upstream_files
    }
    unexpected = sorted((tracked | untracked) - recorded_paths - candidate_set)
    if unexpected:
        raise ToolError(
            "Unexpected Chromium changes fall outside the recorded series and "
            "candidate allowlist:\n" + "\n".join(unexpected)
        )

    patch_bytes: bytes
    overlap = tuple(sorted(recorded_paths & candidate_set))
    with temporary_git_index(paths) as (environment, temporary):
        baseline_tree = populate_temporary_index(paths, manifest.patches, environment)
        require_recorded_paths_at_baseline(
            paths, recorded_paths, candidate_set, environment
        )

        unchanged = [
            relative_path
            for relative_path in candidates
            if not candidate_changed_from_baseline(paths, relative_path, environment)
        ]
        if unchanged:
            raise ToolError(
                "Candidate paths do not differ from the recorded-series baseline:\n"
                + "\n".join(unchanged)
            )

        run(
            ["git", "add", "-A", "--", *candidates],
            cwd=paths.chromium_src,
            env=environment,
        )
        final_tree = run(
            ["git", "write-tree"],
            cwd=paths.chromium_src,
            env=environment,
        ).stdout.strip()
        if final_tree == baseline_tree:
            raise ToolError("Candidate allowlist produces an empty patch.")

        patch_text = run(
            [
                "git",
                "diff",
                "--binary",
                "--full-index",
                "--no-ext-diff",
                "--no-textconv",
                "--no-renames",
                "--src-prefix=a/",
                "--dst-prefix=b/",
                baseline_tree,
                final_tree,
                "--",
                *candidates,
            ],
            cwd=paths.chromium_src,
            env=environment,
        ).stdout
        patch_bytes = patch_text.encode("utf-8", "surrogateescape")
        prospective_patch = temporary / arguments.name
        prospective_patch.write_bytes(patch_bytes)

        touched = _patch_paths_from_numstat(paths, prospective_patch)
        if touched != candidates:
            raise ToolError(
                "Generated patch paths do not exactly match the candidate allowlist.\n"
                f"allowlist: {list(candidates)}\n"
                f"patch:     {list(touched)}"
            )

        run(
            ["git", "read-tree", baseline_tree],
            cwd=paths.chromium_src,
            env=environment,
        )
        _strict_apply(
            paths,
            prospective_patch,
            env=environment,
            cached=True,
            check_only=True,
        )
        _strict_apply(paths, prospective_patch, env=environment, cached=True)
        applied_tree = run(
            ["git", "write-tree"],
            cwd=paths.chromium_src,
            env=environment,
        ).stdout.strip()
        if applied_tree != final_tree:
            raise ToolError(
                "Strictly applying the prospective patch did not reproduce the "
                "candidate tree."
            )

    digest = hashlib.sha256(patch_bytes).hexdigest()
    if arguments.write:
        try:
            with output_path.open("xb") as output:
                output.write(patch_bytes)
        except FileExistsError as exc:
            raise ToolError(
                f"Refusing to overwrite existing patch: {output_path}"
            ) from exc

    print(f"Chromium base: {pin}")
    print(f"Recorded patch prefix: {len(manifest.patches)} patch(es)")
    print(f"Prospective patch: {arguments.name}")
    print("Touched paths:")
    for relative_path in candidates:
        print(f"  {relative_path}")
    print("Recorded-path overlap: " + (", ".join(overlap) if overlap else "none"))
    print(f"SHA-256: {digest}")
    print("Strict application reproduced the exact candidate tree.")
    if arguments.check:
        print("Check complete. No files were written.")
    else:
        print(f"Wrote patch: {output_path}")
    print("Manifest and series were not modified.")
    return 0


def main() -> int:
    try:
        return generate()
    except ToolError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
